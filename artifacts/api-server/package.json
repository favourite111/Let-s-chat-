{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development PORT=${PORT:-8080} node ./build.mjs && NODE_ENV=development PORT=${PORT:-8080} node --enable-source-maps ./dist/index.mjs",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && pnpm run build:test && node --test test/",
    "build:test": "esbuild src/test-entry.ts --bundle --platform=node --format=esm --outfile=dist/test-entry.mjs --external:better-sqlite3 --external:pg --external:redis --external:pino --external:pino-pretty --external:thread-stream --log-level=warning"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "better-sqlite3": "^11.10.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.20.0",
    "pino": "^9",
    "pino-http": "^10",
    "redis": "^6.3.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.18.0",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pg-mem": "^3.0.14",
    "pino-pretty": "^13",
    "socket.io-client": "^4.8.3",
    "thread-stream": "3.1.0"
  }
}
