# ---------------------------------------------------------------------------
# VideoCall — environment variables
# Copy to .env for local development. Nothing here is required to run the
# single-instance demo; everything has a safe default.
# ---------------------------------------------------------------------------

# --- API server -------------------------------------------------------------
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Set to 0 if the app is exposed directly (no reverse proxy in front).
TRUST_PROXY=1

# Comma-separated allowlist. When empty the server reflects the caller's
# origin; set this in production, e.g. https://videocall.example.com
CORS_ORIGINS=

# Per-IP rate limits (requests per minute).
RATE_LIMIT_PER_MINUTE=600
ROOM_CREATE_LIMIT_PER_MINUTE=30
# Hard cap on rooms held in memory.
MAX_ROOMS=10000

# --- Frontend (Vite) --------------------------------------------------------
# Port Vite listens on in dev; also read at build time.
UI_PORT=5173
BASE_PATH=/
# Where `pnpm dev` proxies /api and /socket.io.
API_URL=http://localhost:8080

# --- TURN relay (strongly recommended for mobile networks) ------------------
# Without a TURN server, peers behind carrier-grade NAT often cannot connect.
TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Optional database (unused by the app today) ----------------------------
DATABASE_URL=
