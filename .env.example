# ---------------------------------------------------------------------------
# VideoCall — environment variables
# Copy to .env for local development. Nothing here is required to run the
# single-instance demo; everything has a safe default.
# ---------------------------------------------------------------------------

# --- API server -------------------------------------------------------------
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Set to 0 if the app is exposed directly (no reverse proxy in front).
TRUST_PROXY=1

# Comma-separated allowlist. When empty the server reflects the caller's
# origin; set this in production, e.g. https://videocall.example.com
CORS_ORIGINS=

# Per-IP rate limits (requests per minute).
RATE_LIMIT_PER_MINUTE=600
ROOM_CREATE_LIMIT_PER_MINUTE=30
# Hard cap on rooms held in memory.
MAX_ROOMS=10000

# --- Frontend (Vite) --------------------------------------------------------
# Port Vite listens on in dev; also read at build time.
UI_PORT=5173
BASE_PATH=/
# Where `pnpm dev` proxies /api and /socket.io.
API_URL=http://localhost:8080

# --- TURN relay (strongly recommended for mobile networks) ------------------
# Without a TURN server, peers behind carrier-grade NAT often cannot connect.
TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Storage ----------------------------------------------------------------
# STORE=auto     → Postgres when DATABASE_URL is set, otherwise SQLite (default)
# STORE=sqlite   → force SQLite (room file on disk; survives restarts)
# STORE=postgres → force Postgres (requires DATABASE_URL)
# STORE=memory   → volatile, for tests
STORE=auto

# SQLite is the default and is all a VPS needs. The directory is created on
# boot. If you set this explicitly and it is not writable, the server refuses
# to start rather than silently losing rooms on restart.
SQLITE_PATH=./data/videocall.db

# Optional: rooms in Postgres instead of SQLite (set STORE=postgres to force).
DATABASE_URL=

# Optional: Redis for presence + the Socket.IO adapter (only needed when you
# run more than one instance). Single VPS: leave empty.
REDIS_URL=

# Room housekeeping.
ROOM_TTL_MS=7200000
ROOM_SWEEP_INTERVAL_MS=300000
MAX_PARTICIPANTS=2
