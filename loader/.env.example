# ─────────────────────────────────────────────────────────────────────────────
#  Loader configuration — copy to .env and edit.
#  Everything here is optional except what you actually want to change.
# ─────────────────────────────────────────────────────────────────────────────

# ── Deploy mode ──────────────────────────────────────────────────────────────
# prebuilt → download the published release (2 MB, ~230 files, no build).
#            Use this on small panels: it creates ~230 files instead of ~43,000,
#            so it never trips a file-creation burst limiter.
# source   → download the repo and build it here (needs ~1 GB disk, pnpm,
#            a C toolchain, and no burst limit)
# auto     → prebuilt when a release exists, otherwise source
DEPLOY_MODE=prebuilt

# ── Where the code comes from ────────────────────────────────────────────────
REPO_URL=https://github.com/favourite111/Let-s-chat-
BRANCH=main
# Only needed for a private repo (fine-grained token, Contents: Read).
GITHUB_TOKEN=

# ── Runtime ──────────────────────────────────────────────────────────────────
# Port the app listens on. Put nginx/HTTPS in front of it.
PORT=8080
# Set to 0 if the app is exposed directly with no reverse proxy.
TRUST_PROXY=1
# Set this to your public origin to lock CORS down.
# CORS_ORIGINS=https://call.example.com

# ── Storage (handled automatically) ──────────────────────────────────────────
# The loader always points the app at ./data/videocall.db, which lives OUTSIDE
# the code folder and therefore survives every update. Override only if you
# want the database somewhere else (e.g. a mounted volume).
# SQLITE_PATH=/srv/videocall/data/videocall.db
#
# Optional: use Postgres instead of SQLite.
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/videocall
# Optional: Redis presence + Socket.IO adapter (only for >1 instance).
# REDIS_URL=redis://127.0.0.1:6379

# ── TURN relay (strongly recommended for mobile networks) ────────────────────
# Without this, calls fail behind carrier-grade NAT even though the app is fine.
# TURN_URLS=turn:call.example.com:3478?transport=udp,turn:call.example.com:3478?transport=tcp
# TURN_USERNAME=videocall
# TURN_CREDENTIAL=change-me

# ── Update behaviour ─────────────────────────────────────────────────────────
# 1 = ask GitHub for the latest commit on every start (cheap) and only rebuild
# when it actually changed. 0 = always use whatever is already installed.
CHECK_UPDATES=1
# 1 = rebuild even when the commit is unchanged (use after a failed build).
FORCE_REBUILD=0
# 1 = if a brand-new build crash-loops, switch back to the previous release.
AUTO_ROLLBACK=1

# ── Supervision ──────────────────────────────────────────────────────────────
RESTART_DELAY_MS=3000
MAX_RESTARTS=5
RESTART_WINDOW_MS=60000
BUILD_TIMEOUT_MS=600000
LOG_MAX_BYTES=5242880

# ── Escape hatches ───────────────────────────────────────────────────────────
# BUILD_CMD="pnpm -r --if-present run build"
# INSTALL_CMD="pnpm install --frozen-lockfile"
# START_FILE=artifacts/api-server/dist/index.mjs
